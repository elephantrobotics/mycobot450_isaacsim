#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "mygripper_f100"
    doc = """Generated from Composed Stage of root layer /tmp/tmpp_ww3ea6/mygripper_f100.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_mygripper_f100_n4gejtui/usdex_mygripper_f100/mygripper_f100.usdc


