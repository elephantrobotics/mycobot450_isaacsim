"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mygripper_f100" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </mygripper_f100/Physics/root_joint>,
        </mygripper_f100/Physics/J2_L_Joint>,
        </mygripper_f100/Physics/SL_Joint>,
        </mygripper_f100/Physics/J2_R_joint>,
        </mygripper_f100/Physics/SL_R_joint>,
        </mygripper_f100/Physics/J3_L_Joint>,
        </mygripper_f100/Physics/J3_R_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </mygripper_f100/Geometry/f100_base_link>,
        </mygripper_f100/Geometry/f100_base_link/J2_L_Link>,
        </mygripper_f100/Geometry/f100_base_link/J2_L_Link/J3_L_Link>,
        </mygripper_f100/Geometry/f100_base_link/SL_L_Link>,
        </mygripper_f100/Geometry/f100_base_link/J2_R_Link>,
        </mygripper_f100/Geometry/f100_base_link/J2_R_Link/J3_R_Link>,
        </mygripper_f100/Geometry/f100_base_link/SL_R_Link>,
    ]
    token isaac:robotType = "End Effector"

    over "Geometry"
    {
        over "f100_base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "J2_L_Link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "J3_L_Link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "SL_L_Link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "J2_R_Link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "J3_R_Link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "SL_R_Link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "J2_L_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "J3_L_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "SL_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "J2_R_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "J3_R_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "SL_R_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

