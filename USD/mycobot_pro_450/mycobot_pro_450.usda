def Xform "mycobot_pro450" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    over "Geometry"
    {
        over "base_link"
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Link1"
            {
                over "Link2"
                {
                    over "Link3"
                    {
                        over "Link4"
                        {
                            over "Link5"
                            {
                                over "Link6"
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "joint1"
        {
            float drive:angular:physics:damping = 50
            float drive:angular:physics:stiffness = 500000
